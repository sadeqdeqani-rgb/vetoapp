# Public endpoint and container image names.
APP_DOMAIN=api.example.com
APP_URL=https://api.example.com
HTTP_PORT=80
HTTPS_PORT=443
APP_IMAGE=vetoapp-api
APP_TAG=local
NGINX_IMAGE=vetoapp-nginx
NGINX_TAG=local

# Public WordPress landing. Keep its database credentials and WordPress salts
# separate from every Laravel/MySQL/Valkey secret above or below.
WORDPRESS_BUILD_CONTEXT=../../ورد پرس
WORDPRESS_DOCKERFILE=deployment/Dockerfile.wordpress
WORDPRESS_IMAGE=vetoapp-wordpress
WORDPRESS_TAG=local
WORDPRESS_BASE_IMAGE=wordpress:7.1.1-php8.3-fpm-alpine
WORDPRESS_DB_IMAGE=mariadb:11.4
WORDPRESS_DOMAIN=vetoapp.net
WORDPRESS_WWW_DOMAIN=www.vetoapp.net
WORDPRESS_URL=https://vetoapp.net
WORDPRESS_SITE_TITLE=وِتواَپ
WORDPRESS_ADMIN_USER=vetoapp_admin
WORDPRESS_ADMIN_PASSWORD=CHANGE_ME_WORDPRESS_ADMIN_PASSWORD
WORDPRESS_ADMIN_EMAIL=sadeqdeqani@gmail.com
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DB_NAME=vetoapp_wordpress
WORDPRESS_DB_USER=vetoapp_wordpress
WORDPRESS_DB_PASSWORD=CHANGE_ME_WORDPRESS_DATABASE_PASSWORD
WORDPRESS_DB_ROOT_PASSWORD=CHANGE_ME_WORDPRESS_DATABASE_ROOT_PASSWORD
WORDPRESS_AUTH_KEY=CHANGE_ME_WORDPRESS_AUTH_KEY
WORDPRESS_SECURE_AUTH_KEY=CHANGE_ME_WORDPRESS_SECURE_AUTH_KEY
WORDPRESS_LOGGED_IN_KEY=CHANGE_ME_WORDPRESS_LOGGED_IN_KEY
WORDPRESS_NONCE_KEY=CHANGE_ME_WORDPRESS_NONCE_KEY
WORDPRESS_AUTH_SALT=CHANGE_ME_WORDPRESS_AUTH_SALT
WORDPRESS_SECURE_AUTH_SALT=CHANGE_ME_WORDPRESS_SECURE_AUTH_SALT
WORDPRESS_LOGGED_IN_SALT=CHANGE_ME_WORDPRESS_LOGGED_IN_SALT
WORDPRESS_NONCE_SALT=CHANGE_ME_WORDPRESS_NONCE_SALT
WORDPRESS_BACKUP_PATH=./backups/wordpress
WORDPRESS_BACKUP_INTERVAL_SECONDS=86400
WORDPRESS_BACKUP_RETENTION_DAYS=14
WORDPRESS_BACKUP_ENCRYPTION_PASSPHRASE=

# Laravel application.
APP_NAME=VetoApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_MAINTENANCE_DRIVER=cache
LARAVEL_OPTIMIZE_ON_BOOT=true
# Set exact browser origins only when the Flutter web client is deployed.
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL. DB_PASSWORD must match MYSQL_PASSWORD.
MYSQL_DATABASE=vetoapp
MYSQL_USER=vetoapp
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DATABASE_ROOT_PASSWORD
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vetoapp
DB_USERNAME=vetoapp
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# Valkey. REDIS_PASSWORD must match VALKEY_PASSWORD.
VALKEY_PASSWORD=CHANGE_ME_VALKEY_PASSWORD
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=CHANGE_ME_VALKEY_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# Application integrations: replace every blank value before enabling that feature.
OTP_SERVER_SECRET=
MOBILE_HMAC_SECRET=
ENCRYPTION_KEY_VERSION=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_HTTP_TIMEOUT=10
REGISTRATION_DRAFT_TTL_MINUTES=30
TELEGRAM_LINK_NONCE_TTL_MINUTES=10

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME=VetoApp

FILESYSTEM_DISK=local

# Certificates. APP_DOMAIN must resolve to this server and ports 80/443 must be reachable.
CERTBOT_EMAIL=admin@example.com

# Backup. Set BACKUP_PATH to an encrypted, durable mount; set the passphrase for encrypted archives.
BACKUP_PATH=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE=

# Optional monitoring profile.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
